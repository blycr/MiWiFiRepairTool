<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>MiWiFiRepairTool</AssemblyName>
    <RootNamespace>MiWiFiRepairTool.App</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationDefaultFont>Microsoft YaHei UI, 9pt</ApplicationDefaultFont>
    <Version>0.1.0</Version>
    <Product>小米路由器修复工具（现代化重构版）</Product>
    <Description>小米路由器 TFTP 恢复刷机工具（DHCP + TFTP + 云端 ROM 下载），替代 MIWIFIRepairTool.x86.exe</Description>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MiWiFiRepairTool.Core\MiWiFiRepairTool.Core.csproj" />
  </ItemGroup>

</Project>
